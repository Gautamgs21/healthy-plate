# These are set inside Vercel (Project > Settings > Environment Variables).
# Never put real values in GitHub.

# Added automatically when you connect MongoDB from the Vercel Storage tab.
MONGODB_URI=

# YOU add this one: any long random text, 32+ characters. Used to sign login tokens.
AUTH_SECRET=

# Optional: if set, people need this code to create an account (keeps strangers out).
REGISTRATION_CODE=

# Optional: set to false to stop anyone creating new accounts (after your family has signed up).
ALLOW_REGISTRATION=true

# Optional: database name (default healthyplate).
MONGODB_DB=healthyplate
